# Copy to .env.local for local development. Never commit real credentials.
DATABASE_URL=postgres://irb@localhost:5433/irb
# Used only by the database integration tests; this database is wiped on every test run.
TEST_DATABASE_URL=postgres://irb@localhost:5433/irb_test
# Base URL used in email links.
APP_URL=http://localhost:3000
# Outgoing mail (production: Amazon SES SMTP under the AWS BAA). Unset = emails wait in the outbox.
# SMTP_URL=smtps://USER:PASSWORD@email-smtp.us-east-1.amazonaws.com:465
# MAIL_FROM=IRB <irb@example.org>
# Name shown on letters, minutes and the public page.
IRB_NAME=Institutional Review Board
